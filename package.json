{
  "name": "storyflow",
  "version": "0.20.1",
  "license": "Apache-2.0",
  "description": "Pi-native agent workspace for Storyflow",
  "type": "module",
  "private": true,
  "trustedDependencies": [
    "@google/genai",
    "@vscode/ripgrep",
    "electron",
    "electron-winstaller",
    "esbuild",
    "protobufjs",
    "sharp"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "!apps/online-docs"
  ],
  "scripts": {
    "test": "bun test $(git ls-files --cached --others --exclude-standard -- '*.test.ts' '*.test.tsx' '*.test.js' '*.test.jsx' '*.spec.ts' '*.spec.tsx' ':!apps/catalog-api/**' ':!apps/electron/dist/**' ':!apps/electron/release/**' ':!packages/server-core/src/webui/__tests__/http-server.test.ts') && bun test packages/server-core/src/webui/__tests__/http-server.test.ts && for f in $(git ls-files --cached --others --exclude-standard -- '*.isolated.ts' ':!apps/electron/dist/**' ':!apps/electron/release/**'); do bun test \"./$f\" || exit 1; done",
    "typecheck": "bun run typecheck:shared",
    "typecheck:shared": "cd packages/shared && bun run tsc --noEmit",
    "typecheck:all": "cd packages/core && bun run tsc --noEmit && cd ../shared && bun run tsc --noEmit && cd ../server-core && bun run tsc --noEmit && cd ../server && bun run tsc --noEmit && cd ../session-tools-core && bun run tsc --noEmit && cd ../pi-agent-server && bun run typecheck && cd ../../apps/electron && bun run typecheck && cd ../../packages/ui && bun run tsc --noEmit",
    "server:start": "bun run packages/server/src/index.ts",
    "server:dev": "bun run server:build:subprocess && CRAFT_DEBUG=true CRAFT_BUNDLED_ASSETS_ROOT=$PWD/apps/electron bun run packages/server/src/index.ts",
    "server:build": "bun run scripts/build-server.ts",
    "server:build:linux-x64": "bun run scripts/build-server.ts --platform=linux --arch=x64 --compress",
    "server:build:linux-arm64": "bun run scripts/build-server.ts --platform=linux --arch=arm64 --compress",
    "server:build:darwin-arm64": "bun run scripts/build-server.ts --platform=darwin --arch=arm64 --compress",
    "server:build:darwin-x64": "bun run scripts/build-server.ts --platform=darwin --arch=x64 --compress",
    "typecheck:electron": "cd apps/electron && bun run typecheck",
    "test:doc-tools": "uv run python -m unittest apps.electron.resources.scripts.tests.test_pdf_tool_smoke apps.electron.resources.scripts.tests.test_xlsx_tool_smoke apps.electron.resources.scripts.tests.test_docx_tool_smoke apps.electron.resources.scripts.tests.test_pptx_tool_smoke apps.electron.resources.scripts.tests.test_img_tool_smoke apps.electron.resources.scripts.tests.test_ical_tool_smoke apps.electron.resources.scripts.tests.test_doc_diff_smoke apps.electron.resources.scripts.tests.test_markitdown_smoke",
    "test:catalog-api": "uv run --frozen --project apps/catalog-api python -m unittest discover -s apps/catalog-api/src -p 'test_*.py'",
    "validate:dev": "bun run typecheck:all && bun run test:doc-tools",
    "validate:ci": "bun run validate:dev && bun run test && bun run lint:i18n:parity && bun run lint:i18n:sorted && bun run lint:i18n:coverage",
    "lint:ipc-sends": "bash scripts/check-raw-sends.sh",
    "lint:electron": "cd apps/electron && bun run lint",
    "lint:shared": "cd packages/shared && npx eslint .",
    "lint:ui": "cd packages/ui && npx eslint .",
    "lint:i18n:parity": "bun run scripts/check-i18n-parity.ts",
    "lint:i18n:coverage": "bun run scripts/check-i18n-coverage.ts",
    "sort-locales": "bun scripts/sort-locales.ts",
    "lint:i18n:sorted": "bun scripts/sort-locales.ts --check",
    "lint": "bun run lint:ipc-sends && bun run lint:electron && bun run lint:shared && bun run lint:ui",
    "link": "bun link",
    "electron:clean": "bun run scripts/electron-clean.ts",
    "electron:build:main": "bun run scripts/electron-build-main.ts",
    "electron:build:preload": "bun run scripts/electron-build-preload.ts",
    "electron:build:renderer": "bun run scripts/electron-build-renderer.ts",
    "electron:build:resources": "bun run scripts/electron-build-resources.ts",
    "build:wa-worker": "bun run scripts/build-wa-worker.ts",
    "electron:build:assets": "cd apps/electron && bun scripts/copy-assets.ts",
    "electron:build:validate": "cd apps/electron && bun run build:validate",
    "electron:build": "bun run electron:build:main && bun run electron:build:preload && bun run electron:build:renderer && bun run electron:build:assets && bun run electron:build:validate",
    "electron:start": "bun run electron:build && electron apps/electron",
    "electron:dev": "bun run scripts/electron-dev.ts",
    "electron:dev:terminal": "bun run scripts/electron-dev.ts --terminal",
    "perf:electron": "bun run scripts/electron-perf-summary.ts",
    "perf:fixture": "bun run scripts/perf/generate-fixture.ts",
    "perf:e2e": "bun run e2e/perf/run.ts",
    "e2e:core": "bun run e2e/core/run.ts",
    "print:system-prompt": "bun run packages/pi-agent-server/src/print-system-prompt.ts",
    "browser-tool": "bun run scripts/browser-tool.ts",
    "electron:dist": "bun run scripts/build.ts",
    "electron:dist:mac": "bun run scripts/build.ts --platform=darwin",
    "electron:dist:win": "bun run scripts/build.ts --platform=win32",
    "electron:dist:linux": "bun run scripts/build.ts --platform=linux",
    "electron:dist:dev:mac": "CRAFT_DEV_RUNTIME=1 bun run scripts/build.ts --platform=darwin",
    "electron:dist:dev:win": "CRAFT_DEV_RUNTIME=1 bun run scripts/build.ts --platform=win32",
    "electron:dist:dev:linux": "CRAFT_DEV_RUNTIME=1 bun run scripts/build.ts --platform=linux",
    "playground:dev": "lsof -ti:5173 | xargs kill -9 2>/dev/null; vite dev --config apps/electron/vite.config.ts --open /playground.html",
    "viewer:dev": "lsof -ti:5174 | xargs kill -9 2>/dev/null; vite dev --config apps/viewer/vite.config.ts --open /s/tz5-13I84pwK_he",
    "viewer:typecheck": "cd apps/viewer && bun run typecheck",
    "viewer:build": "vite build --config apps/viewer/vite.config.ts",
    "viewer:preview": "vite preview --config apps/viewer/vite.config.ts",
    "webui:dev": "lsof -ti:5175 | xargs kill -9 2>/dev/null; vite dev --config apps/webui/vite.config.ts",
    "webui:clean": "rm -rf apps/webui/dist",
    "webui:build": "vite build --config apps/webui/vite.config.ts",
    "webui:typecheck": "cd apps/webui && bun run typecheck",
    "server:build:subprocess": "bun run --cwd packages/pi-agent-server build",
    "server:prod": "bun run server:build:subprocess && bun run webui:build && CRAFT_WEBUI_DIR=apps/webui/dist CRAFT_BUNDLED_ASSETS_ROOT=$PWD/apps/electron bun run packages/server/src/index.ts",
    "server:dev:webui": "bun run server:build:subprocess && bun run webui:build && CRAFT_WEBUI_DIR=apps/webui/dist CRAFT_WEBUI_PORT=3100 bun run server:dev",
    "auth-broker:dev": "bun run scripts/auth-broker-dev.ts",
    "marketing:dev": "vite dev --config apps/marketing/vite.config.ts",
    "marketing:build": "bun run scripts/build-marketing.ts",
    "marketing:preview": "vite preview --config apps/marketing/vite.config.ts",
    "skills-market:verify": "bun run scripts/verify-skills-market.ts",
    "mcp-market:verify": "bun run scripts/verify-mcp-market.ts",
    "release:upload-r2": "bun run scripts/upload-r2-release-assets.ts",
    "release:whats-new": "bun run scripts/generate-whats-new.ts",
    "docs:dev": "cd apps/online-docs && npm install && npx mintlify dev",
    "build": "bun run scripts/build.ts",
    "release": "bun run scripts/release.ts",
    "check-version": "bun run scripts/check-version.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@rollup/rollup-win32-arm64-msvc": "^4.55.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/linkify-it": "^5.0.0",
    "@types/node": "^25.0.8",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/shell-quote": "^1.7.5",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.0.0",
    "vite": "^6.2.4"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-file-handler": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-mathematics": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-table": "3.20.0",
    "@tiptap/extension-task-item": "^3.20.0",
    "@tiptap/extension-task-list": "^3.20.0",
    "@tiptap/markdown": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/suggestion": "^3.20.0",
    "@vscode/ripgrep": "^1.18.0",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "jotai": "^2.16.0",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.33",
    "linkify-it": "^5.0.0",
    "lucide-react": "^0.561.0",
    "markitdown-js": "^0.0.14",
    "open": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.19.0",
    "tailwind-merge": "^3.4.0",
    "tiptap-extension-code-block-shiki": "^1.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-linux-arm64": "0.35.3",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-libvips-linux-arm64": "1.3.2",
    "@img/sharp-libvips-linux-x64": "1.3.2"
  }
}
